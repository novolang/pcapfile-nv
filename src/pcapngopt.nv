// pcapngopt.nv — a pcapng option, whose code means different things
// in different blocks.
//
// Every body here is a `todo()`; the signatures are the design.
//
// THE SAME NUMBER, THREE MEANINGS
//
// Every pcapng block may end with a list of options, and an option is
// a 16-bit code, a 16-bit length, the value, and padding to the next
// 32-bit boundary.  Code 1 is `opt_comment` in every block.  Code 2
// is `shb_hardware` in a Section Header Block, `if_name` in an
// Interface Description Block, `epb_flags` in an Enhanced Packet
// Block and `isb_starttime` in an Interface Statistics Block — four
// different things, three of them a different width, and nothing in
// the option itself says which.
//
// A library that offered `find(options, 2)` would be handing its
// callers that collision, and the way it goes wrong is quiet: reading
// an Enhanced Packet Block's four-octet flags word as an interface
// name gives a short string of control characters, and no reader
// complains.  So the lookup here is `pcapngopt.named`, which takes
// the block kind as well, and `PcapngOptionName` is an enum whose
// arms are the (block, code) pairs rather than the codes.
//
// A VALUE IS OCTETS
//
// An option's value is octets, and the specification says what shape
// they are per option: a string for `if_name`, one octet for
// `if_tsresol`, eight for `if_speed`, four for `epb_flags`.  The
// readers below take the shape as the function they are, so a caller
// asking for the wrong one gets `None` rather than a plausible
// number.
//
// PADDING IS NOT VALUE
//
// The length field counts the value and not the padding, but the
// block's total length counts both.  A reader that walked options by
// the length field alone falls off the alignment at the first option
// whose value is not a multiple of four — which is most of them,
// because `if_tsresol` is one octet.

// One option, as it lies in a block.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     let o = pcapngopt.option(1, list.zeros(4))
//     println("${o.code} ${list.len(o.value)}")       // 1 4
// ```
pub struct PcapngOption
    // The 16-bit option code, as the block wrote it.  Its meaning
    // depends on the block: `pcapngopt.option_name` is the pair.
    code: Int
    // The value, exactly as long as the option's length field said.
    // The padding to the next 32-bit boundary is not here.
    value: [u8]

// An option code, in the block that gives it its meaning.
//
// The arms are the codes this package knows how to read.  A code it
// does not know is `PcapngOptOther`, carrying the number, because an
// option nobody understands is still an option that has to be walked
// past.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println("${pcapngopt.option_code(PcapngIfTsResol)}")    // 9
// ```
pub enum PcapngOptionName
    // Code 0 in every block: the end of the options list.  It has no
    // value and everything after it in the block is padding.
    PcapngOptEndOfOpt
    // Code 1 in every block: a UTF-8 comment.  The one option that
    // may appear more than once, which is why `pcapngopt.all` exists.
    PcapngOptComment
    // Section Header Block, code 2: the machine the capture was made
    // on, as text.
    PcapngShbHardware
    // Section Header Block, code 3: the operating system, as text.
    PcapngShbOs
    // Section Header Block, code 4: the program that wrote the file,
    // as text.
    PcapngShbUserAppl
    // Interface Description Block, code 2: the interface's name, as
    // text — `eth0`, `\Device\NPF_{...}`.
    PcapngIfName
    // Interface Description Block, code 3: a longer description, as
    // text.
    PcapngIfDescription
    // Interface Description Block, code 8: the interface's speed in
    // bits per second, as eight octets.
    PcapngIfSpeed
    // Interface Description Block, code 9: ONE octet giving the
    // timestamp resolution, whose top bit picks a power of two over a
    // power of ten.  Absent means microseconds.
    PcapngIfTsResol
    // Interface Description Block, code 11: the capture filter, whose
    // first octet says what kind of filter the rest is.
    PcapngIfFilter
    // Interface Description Block, code 12: the capturing operating
    // system, as text.  Separate from `shb_os` because a file may
    // hold interfaces from several machines.
    PcapngIfOs
    // Interface Description Block, code 13: one octet giving how many
    // octets of frame check sequence are included in the captured
    // octets.  A program that verified an Ethernet FCS without
    // reading this verifies four octets of payload.
    PcapngIfFcsLen
    // Interface Description Block, code 14: eight octets of seconds
    // added to every timestamp on this interface.  Absent means zero.
    PcapngIfTsOffset
    // Interface Description Block, code 15: the capture hardware, as
    // text.
    PcapngIfHardware
    // Enhanced Packet Block, code 2: four octets of flags — the
    // direction, the reception type, and the link-layer errors the
    // capture saw.
    PcapngEpbFlags
    // Enhanced Packet Block, code 3: a hash of the packet, whose
    // first octet says which algorithm.
    PcapngEpbHash
    // Enhanced Packet Block, code 4: eight octets counting the
    // packets lost between this one and the previous one on the same
    // interface.
    PcapngEpbDropCount
    // Enhanced Packet Block, code 5: eight octets identifying the
    // packet, so that the same packet seen on two interfaces can be
    // recognised.
    PcapngEpbPacketId
    // Interface Statistics Block, code 2: eight octets giving when
    // the capture on this interface started.
    PcapngIsbStartTime
    // Interface Statistics Block, code 3: eight octets giving when it
    // ended.
    PcapngIsbEndTime
    // Interface Statistics Block, code 4: eight octets counting the
    // packets the interface received.
    PcapngIsbIfRecv
    // Interface Statistics Block, code 5: eight octets counting the
    // packets the interface dropped.  The number that says whether a
    // capture is complete, and the one most tools never show.
    PcapngIsbIfDrop
    // Interface Statistics Block, code 6: eight octets counting the
    // packets the capture filter accepted.
    PcapngIsbFilterAccept
    // Interface Statistics Block, code 7: eight octets counting the
    // packets the operating system dropped.
    PcapngIsbOsDrop
    // Interface Statistics Block, code 8: eight octets counting the
    // packets delivered to the capturing program.  The difference
    // between this and `isb_ifrecv` is what a capture missed.
    PcapngIsbUsrDeliv
    // Any other code, in whatever block it was found in.
    PcapngOptOther(code: Int)

// An option.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println("${pcapngopt.option(9, list.zeros(1)).code}")   // 9
// ```
pub fn option(code: Int, value: [u8]) -> PcapngOption
    todo("pcapfile-nv.pcapngopt.option")

// A comment option: code 1, with the text as UTF-8.
//
// The one option any block may carry and any block may carry several
// of, and the one a program adding provenance to a capture wants.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println("${pcapngopt.comment("captured at the edge router").code}")  // 1
// ```
pub fn comment(text: Str) -> PcapngOption
    todo("pcapfile-nv.pcapngopt.comment")

// The end-of-options option: code 0, with no value.
//
// A block whose options list is not empty ends with one.  A reader
// that walked past it would read the block's padding as more options.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println("${list.len(pcapngopt.end_of_options().value)}")    // 0
// ```
pub fn end_of_options() -> PcapngOption
    todo("pcapfile-nv.pcapngopt.end_of_options")

// What an option code means in a given block.
//
// THE FUNCTION THE MODULE IS FOR.  The block is an argument because
// the code alone does not determine the meaning: code 2 is four
// different options in the four blocks that define one.
//
// ```novo
// use pcapngopt
// use pcapngblock
//
// fn main() [io]
//     match pcapngopt.option_name(PcapngInterfaceDescription, 2)
//         PcapngIfName => println("if_name")
//         _            => println("something else")
// ```
pub fn option_name(b: PcapngBlockType, code: Int) -> PcapngOptionName
    todo("pcapfile-nv.pcapngopt.option_name")

// The 16-bit code an option name is written as.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println("${pcapngopt.option_code(PcapngIsbIfDrop)}")    // 5
// ```
pub fn option_code(n: PcapngOptionName) -> Int
    todo("pcapfile-nv.pcapngopt.option_code")

// The specification's name for an option, in its block:
// `"if_tsresol"`, `"epb_flags"`, `"opt_comment"`.
//
// An option this package does not know answers `"opt_"` followed by
// its code, so a dump of an unfamiliar capture still reads.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println(pcapngopt.option_label(PcapngIfTsOffset))       // if_tsoffset
// ```
pub fn option_label(n: PcapngOptionName) -> Str
    todo("pcapfile-nv.pcapngopt.option_label")

// The first option in the list with this name, in this block, or
// `None`.
//
// The lookup a caller should reach for, because it cannot be given
// the wrong block: the name and the block are checked against each
// other, and asking an Interface Description Block for
// `PcapngEpbFlags` answers `None` rather than its `if_name`.
//
// ```novo
// use pcapngopt
// use pcapngblock
//
// fn main() [io]
//     let opts = [pcapngopt.option(9, list.zeros(1))]
//     match pcapngopt.named(opts, PcapngInterfaceDescription, PcapngIfTsResol)
//         Some(o) => println("${list.len(o.value)}")          // 1
//         None    => println("no if_tsresol on this interface")
// ```
pub fn named(options: [PcapngOption], b: PcapngBlockType, n: PcapngOptionName) -> ?PcapngOption
    todo("pcapfile-nv.pcapngopt.named")

// Every option in the list with this name, in this block.
//
// For `opt_comment`, which may repeat.  Every other option appears at
// most once, and a block that repeats one is a block whose writer had
// a bug — this answers both, in the order they were written, and lets
// the caller decide.
//
// ```novo
// use pcapngopt
// use pcapngblock
//
// fn main() [io]
//     let opts = [pcapngopt.comment("first"), pcapngopt.comment("second")]
//     println("${list.len(pcapngopt.all(opts, PcapngSectionHeader, PcapngOptComment))}")
// ```
pub fn all(options: [PcapngOption], b: PcapngBlockType, n: PcapngOptionName) -> [PcapngOption]
    todo("pcapfile-nv.pcapngopt.all")

// An option's value as UTF-8 text.
//
// For the options the specification says are text: the comment, the
// interface name and description, the hardware and operating system
// strings.  The value is NOT NUL-terminated in the file, and a reader
// that trimmed a trailing NUL would be trimming a legal last
// character; what is trimmed is nothing.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println(pcapngopt.text_of(pcapngopt.comment("eth0 at the edge")))
// ```
pub fn text_of(o: PcapngOption) -> Str
    todo("pcapfile-nv.pcapngopt.text_of")

// An option's value as one octet, or `None` when it is not exactly
// one octet long.
//
// For `if_tsresol` and `if_fcslen`, which are the two one-octet
// options.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     match pcapngopt.octet_of(pcapngopt.option(9, list.zeros(1)))
//         Some(v) => println("${v}")                 // 0
//         None    => println("not a one-octet option")
// ```
pub fn octet_of(o: PcapngOption) -> ?Int
    todo("pcapfile-nv.pcapngopt.octet_of")

// An option's value as an unsigned 32-bit number in the section's
// byte order, or `None` when it is not exactly four octets long.
//
// For `epb_flags`.  The byte order is the section's, because an
// option value's integers lie the same way round as the rest of the
// section — which is the rule that makes a capture readable at all,
// and the one a reader mixing network order into it breaks.
//
// ```novo
// use pcapngopt
// use pcapbyte
//
// fn main() [io]
//     match pcapngopt.u32_of(pcapngopt.option(2, list.zeros(4)), PcapLittleEndian)
//         Some(v) => println("${v}")                 // 0
//         None    => println("not a four-octet option")
// ```
pub fn u32_of(o: PcapngOption, ord: PcapByteOrder) -> ?Int
    todo("pcapfile-nv.pcapngopt.u32_of")

// An option's value as an unsigned 64-bit number in the section's
// byte order, or `None` when it is not exactly eight octets long or
// does not fit an `Int`.
//
// For `if_speed`, `if_tsoffset`, the drop counts and the two
// Interface Statistics Block instants.
//
// ```novo
// use pcapngopt
// use pcapbyte
//
// fn main() [io]
//     match pcapngopt.u64_of(pcapngopt.option(8, list.zeros(8)), PcapBigEndian)
//         Some(v) => println("${v}")                 // 0
//         None    => println("not an eight-octet option")
// ```
pub fn u64_of(o: PcapngOption, ord: PcapByteOrder) -> ?Int
    todo("pcapfile-nv.pcapngopt.u64_of")

// How many octets this option occupies in a block: four of header,
// the value, and the padding to the next 32-bit boundary.
//
// The number a writer sums to find a block's total length, and the
// number a reader steps by.  Writing it once is the whole defence
// against the alignment bug, which otherwise appears at the first
// option whose value is not a multiple of four.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println("${pcapngopt.padded_length(pcapngopt.option(9, list.zeros(1)))}")   // 8
// ```
pub fn padded_length(o: PcapngOption) -> Int
    todo("pcapfile-nv.pcapngopt.padded_length")

// How many octets of padding follow a run of `length` octets, to
// reach the next 32-bit boundary.
//
// 0, 3, 2 or 1.  Both formats pad every option value and every
// pcapng packet payload this way, so the one function serves both and
// nothing in the package computes it twice.
//
// ```novo
// use pcapngopt
//
// fn main() [io]
//     println("${pcapngopt.padding_for(1)}")         // 3
//     println("${pcapngopt.padding_for(4)}")         // 0
// ```
pub fn padding_for(length: Int) -> Int
    todo("pcapfile-nv.pcapngopt.padding_for")

// Every option in an options area, read from octets.
//
// Stops at the `opt_endofopt`, and stops at the end of the octets for
// a block whose writer left it out — which is legal when there are no
// options at all and is a bug otherwise, and either way a reader that
// insisted would refuse files that everything else reads.
//
// `PcapBadOption` when an option's length runs past the end of the
// area, and `PcapTooManyOptions` when there are more than `limit` of
// them.
//
// ```novo
// use pcapngopt
// use pcapbyte
//
// fn main() [io]
//     match pcapngopt.parse_options(list.zeros(4), PcapLittleEndian, 64, 0)
//         Ok(opts) => println("${list.len(opts)}")
//         Err(e)   => println(e.message())
// ```
pub fn parse_options(bytes: [u8], ord: PcapByteOrder, limit: Int,
                     at: Int) -> Result<[PcapngOption], PcapError>
    todo("pcapfile-nv.pcapngopt.parse_options")
